# The AUR's package, built from the release's source. pkgver and the
# checksum are the release's (packaging/README.md).
pkgname=openwgt
pkgver=0.12.0
pkgrel=1
pkgdesc="An open engine for Maxis' Widget Workshop, with its own graphics, sounds and data"
arch=('x86_64' 'aarch64')
url="https://gustavn.se/openwgt"
license=('AGPL-3.0-or-later' 'LGPL-2.1-or-later' 'OFL-1.1')
depends=('alsa-lib' 'gcc-libs' 'glibc' 'hicolor-icon-theme' 'libxkbcommon' 'vulkan-icd-loader')
optdepends=('wayland: Wayland sessions'
            'libx11: X11 sessions'
            'libxcursor: X11 sessions'
            'libxi: X11 sessions'
            'libxrandr: X11 sessions'
            'xdg-desktop-portal: the file dialog Change CD... picks the CD image with')
makedepends=('cargo' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::https://github.com/gustavn64/OpenWGT/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "OpenWGT-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "OpenWGT-$pkgver"
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
    cargo build --frozen --release -p openwgt
}

check() {
    cd "OpenWGT-$pkgver"
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
    cargo test --frozen --release --workspace
}

package() {
    cd "OpenWGT-$pkgver"
    install -Dm755 target/release/openwgt "$pkgdir/usr/bin/openwgt"
    install -Dm644 crates/openwgt/res/openwgt.desktop "$pkgdir/usr/share/applications/openwgt.desktop"
    install -Dm644 crates/openwgt/res/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/openwgt.png"
    install -Dm644 README.md "$pkgdir/usr/share/doc/openwgt/README.md"
    # the bundled fonts' licences (they're in the program)
    install -Dm644 -t "$pkgdir/usr/share/licenses/openwgt/fonts" crates/engine/fonts/README.md crates/engine/fonts/LICENSE-*.txt
}

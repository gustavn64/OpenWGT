# Copyrighted game data: never commit. Users supply their own CD image.
*.iso
*.ISO
*.bin
*.cue
/orig/
*.EXE
*.exe
*.DLL
*.dll
*.WGT
*.wgt
*.PZL
*.SLF
*.WAV
*.HLP

# The port's own data (OpenWDATA) is the project's, in the game's formats.
!/crates/engine/opendata/**
!/crates/engine/opendata-sv/**
!/crates/engine/opendata-fr/**
# The network parts' own (tools/opennet), the same.
!/crates/engine/opennet/**
!/crates/engine/opennet-sv/**
!/crates/engine/opennet-fr/**
# The port's own example widgets (examples/net, built by the engine's tests).
!/examples/**

# Build output
/target/
/result
/dist/
/web/

# Ghidra project (contains the original binaries). What it shows is written
# up in docs/ instead. pzl_dump.py, beside it, is the project's own.
/ghidra/*
!/ghidra/pzl_dump.py

# Python
__pycache__/
*.pyc
/.venv/
